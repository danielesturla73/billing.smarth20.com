# Copia questo file in ".env" (mai versionato in git, contiene un segreto)
# e sostituisci i valori. Vedi project doc "riepilogo-progetto-wms-smarth2o.md",
# sezione 4.9, per il perché di questi due valori.

# Token condiviso per autenticare le chiamate tra Fatturazione Utenze e
# WMS SmartH2O sulla rete Docker interna (stessa chiave configurata anche
# lato WMS SmartH2O). Anche se il traffico resta "in casa" sulla stessa
# VPS, protegge da un bug o un accesso indesiderato che scriva dati
# sbagliati nel bilancio idrico. Generane una vera con, ad esempio:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_TOKEN=cambiami-con-una-chiave-vera

# Indirizzo interno di WMS SmartH2O sulla rete Docker condivisa — il NOME
# del servizio (definito nel suo docker-compose/docker run), non un IP:
# gli IP dei container possono cambiare ad ogni riavvio, i nomi no.
WMS_API_URL=http://wms-backend:8000
